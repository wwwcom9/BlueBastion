# Unity 工程 .gitignore
# 放在 Unity 工程根目录（和 Assets、ProjectSettings 同级）
# 来源：https://github.com/github/gitignore/blob/main/Unity.gitignore

# ===== Unity 自动生成的缓存（绝不能提交，动辄几个 GB）=====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 资源对应的 meta 文件必须保留（Unity 靠它维持引用关系）
!/[Aa]ssets/**/*.meta

# Asset Store 工具插件
# /[Aa]ssets/AssetStoreTools*

# Rider 自动生成的插件
/[Aa]ssets/Plugins/Editor/JetBrains*

# ===== IDE 缓存与工程文件 =====
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 生成的 meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# 崩溃报告
sysinfo.txt

# ===== 打包产物 =====
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Addressables 打包缓存
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Android 临时资源
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini
